    "/contracts/{contract_id}/messages": {
      "post": {
        "tags": [
          "contratos"
        ],
        "summary": "Send Message",
        "description": "Un turno de conversación: texto y/o archivos (PDF, PNG, JPG, WEBP).\n\nEl mensaje y la respuesta quedan guardados en el historial (``GET .../messages``) y los\narchivos se conservan para poder verlos de nuevo (``GET .../attachments/{id}``).",
        "operationId": "send_message_contracts__contract_id__messages_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Contract Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_send_message_contracts__contract_id__messages_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "contratos"
        ],
        "summary": "Get Messages",
        "description": "Historial del chat en orden cronológico, paginado hacia atrás.\n\nPedí sin ``before`` para los últimos ``limit`` mensajes; si ``has_more`` es true, volvé a\npedir con ``before=next_before`` para los anteriores. Solo lo ve el solicitante dueño.",
        "operationId": "get_messages_contracts__contract_id__messages_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Contract Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Traer los anteriores a este seq",
              "title": "Before"
            },
            "description": "Traer los anteriores a este seq"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

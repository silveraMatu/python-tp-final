    "/contracts/{contract_id}/review": {
      "post": {
        "tags": [
          "revisión"
        ],
        "summary": "Review Contract",
        "description": "Registra la decisión del revisor sobre un contrato pendiente de revisión.\n\n- ``APPROVE``: aprueba (el documento final se emite al descargarlo).\n- ``REJECT``: rechaza; el contrato queda cerrado.\n- ``REQUEST_CHANGES``: lo devuelve al solicitante para completar o corregir datos.",
        "operationId": "review_contract_contracts__contract_id__review_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Contract Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/contracts/{contract_id}/document": {
      "get": {
        "tags": [
          "documentos"
        ],
        "summary": "Download Document",
        "description": "Descarga el documento.\n\n- ``version=draft``: PDF preliminar con marca de BORRADOR (solo antes de la decisión).\n- ``version=final``: PDF o DOCX del contrato aprobado; se emite una sola vez y las\n  descargas siguientes entregan el mismo archivo.\n\nEl encabezado ``X-Verification-Code`` trae el código impreso en el pie del PDF.",
        "operationId": "download_document_contracts__contract_id__document_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Contract Id"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "draft",
                "final"
              ],
              "type": "string",
              "default": "final",
              "title": "Version"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "pdf",
                "docx"
              ],
              "type": "string",
              "default": "pdf",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/pdf": {},
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

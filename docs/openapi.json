  "components": {
    "schemas": {
      "AttachmentMeta": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "examples": [
              "dni.png"
            ]
          },
          "media_type": {
            "type": "string",
            "title": "Media Type",
            "examples": [
              "image/png"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Ruta relativa para descargarlo (requiere X-API-Key)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "media_type",
          "size_bytes",
          "sha256",
          "url"
        ],
        "title": "AttachmentMeta",
        "description": "Archivo adjunto a un mensaje del usuario."
      },
      "AuditEntryOut": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "actor",
          "action",
          "status"
        ],
        "title": "AuditEntryOut",
        "description": "Entrada de la auditoría de un contrato."
      },
      "Body_send_message_contracts__contract_id__messages_post": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 20000,
            "title": "Message",
            "default": ""
          },
          "files": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "contentMediaType": "application/octet-stream"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Files"
          }
        },
        "type": "object",
        "title": "Body_send_message_contracts__contract_id__messages_post"
      },
      "ChatMessage": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "seq": {
            "type": "integer",
            "title": "Seq",
            "description": "Orden dentro del contrato (1, 2, 3, ...)."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "description": "Usuario que originó el mensaje; 'assistant' para el agente."
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent",
            "description": "Solo en respuestas del agente."
          },
          "classification_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classification Source"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Fuentes citadas (consultas)."
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentRef"
            },
            "type": "array",
            "title": "Documents"
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/AttachmentMeta"
            },
            "type": "array",
            "title": "Attachments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "seq",
          "timestamp",
          "role",
          "actor",

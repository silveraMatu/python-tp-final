# Copiar a .env y ajustar. Todas las variables tienen un valor por defecto.

# --- LLM (Ollama) ---
# Con modelos ":cloud" el texto y las imágenes viajan a Ollama Cloud: usar solo datos ficticios.
HUMANIA_OLLAMA_HOST=http://localhost:11434
HUMANIA_OLLAMA_TEXT_MODEL=deepseek-v4.1-flash:cloud
HUMANIA_OLLAMA_VISION_MODEL=deepseek-v4.1-flash:cloud
HUMANIA_OLLAMA_THINK=false
HUMANIA_OLLAMA_TIMEOUT=120

# --- Extracción y validación ---
HUMANIA_CONFIDENCE_THRESHOLD=0.80
HUMANIA_EXTRACTION_MAX_RETRIES=2
HUMANIA_MAX_UPLOAD_BYTES=15728640
HUMANIA_MAX_DOCUMENT_PAGES=3
HUMANIA_MAX_IMAGE_SIDE=1280

# --- Persistencia y documentos ---
HUMANIA_DATABASE_PATH=data/contracts.db
HUMANIA_OUTPUT_DIR=data/output
HUMANIA_TEMPLATE_PATH=app/templates/contrato_trabajo_indeterminado.docx
HUMANIA_CITY=Córdoba
